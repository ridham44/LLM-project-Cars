# Copy to .env. Nothing here is a secret - ports, hosts, model choices and
# performance switches for this machine.

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

FRONTEND_HOST=localhost
FRONTEND_PORT=3000

OLLAMA_HOST=http://127.0.0.1:11434

# Automatically run `ollama pull <model>` for any model configured below that
# isn't installed yet.
AUTO_PULL_MODELS=false

# How long (seconds) the launcher waits for Ollama/backend/frontend readiness.
START_TIMEOUT=90
BROWSER_AUTO_OPEN=true


# =============================================================================
# MODEL ROUTING - one question, one answer model
# =============================================================================
# Exactly ONE of these models answers any given request. There is no critic
# after it, no claim-extraction model, and no judge. model_router.select()
# picks the tier from the classified intent and complexity.
#
# Defaults were chosen from a benchmark of every installed model on this
# machine, same RAG prompt (raw numbers in ARCHITECTURE_AUDIT.md):
#
#   model                        cold load   tok/s   400-token answer (warm)
#   qwen2.5:1.5b                     21.5s    44.2                    11.0s
#   deepseek-r1:1.5b                 39.2s    42.4                    11.3s
#   qwen2.5:3b                       32.1s    37.8                    13.1s
#   gemma3:4b                        94.2s    29.3                    16.6s
#   mistral:7b-instruct-q4_K_M       56-86s    7.8                   141.1s
#   deepseek-r1:7b                  98-111s    8.1                   150.5s
#   qwen2.5:7b                      98-115s    7.9                   168.3s
#   llama3.1:8b-instruct-q4_K_M     93-107s    5.7                   180.1s
#
# Every 7B+ model paid a FULL cold load again on a back-to-back second call, so
# a 7B tier costs a reload PLUS ~50s of generation on every request. That is
# why none of them is a default.

# FACTUAL + LOW complexity. Measured 3.3s end to end when resident.
# FAST_MODEL=qwen2.5:1.5b

# Research, analysis, comparisons, summaries. Measured 7.3s when resident.
# RESEARCH_MODEL=qwen2.5:3b

# VERY_HIGH complexity only. Defaults to the same model as RESEARCH_MODEL,
# because on this hardware nothing larger meets the latency target - the tier
# differs by evidence count and answer length instead of by model size.
# HEAVY_RESEARCH_MODEL=qwen2.5:3b

# VERIFY / recheck / doubt. DeepSeek-R1 lineage, a different family from every
# answering tier - when the user challenges an answer, re-running the model
# that wrote it is the least useful thing the system could do.
# VERIFY_MODEL=deepseek-r1:1.5b

# Classifies ONLY when the phrase and embedding layers are both inconclusive.
# It never writes any part of an answer.
# ROUTER_MODEL=qwen2.5:1.5b

# Vision/document-image tier. Registered but nothing routes to it yet.
# SPECIALIST_MODEL=llava:7b

# Ollama embedding model. Only used as a FALLBACK now - retrieval and intent
# both embed locally through fastembed (see nlp_local.py), which is why a
# vector search costs ~0.04s instead of a variable 0.3-33s.
# EMBEDDING_MODEL=nomic-embed-text


# --- Hardware-aware routing ---------------------------------------------------
# The router refuses a model it projects cannot meet its tier's latency target
# (from the measured rates in config.MODEL_THROUGHPUT_TOK_S) and falls back to
# the next tier down, reporting the substitution in the AI Routing panel.
#
# Set false if you have deliberately pinned a big model and want it regardless -
# e.g. HEAVY_RESEARCH_MODEL=qwen3:8b with ENFORCE_LATENCY_TARGETS=false.
# ENFORCE_LATENCY_TARGETS=true


# --- Query understanding ------------------------------------------------------
# Budget for the one embedding round-trip on the request path. Past this the
# semantic layer logs it and backs off so the next request isn't held up too.
# QUERY_UNDERSTANDING_BUDGET_MS=1500

# The router LLM: hard timeout, and how long to stop trying after one failure.
# ROUTER_TIMEOUT_SECONDS=8
# ROUTER_BACKOFF_SECONDS=60

# Set false to never call the router LLM. Classification then always stops at
# the embedding layer, which is correct for the large majority of queries.
# ROUTER_LLM_ENABLED=true


# =============================================================================
# THE ONE REMAINING LATENCY CLIFF, AND HOW TO REMOVE IT
# =============================================================================
# Measured steady state, all models resident:
#
#   factual question                3.3s
#   comparison / research           7.3s
#   verification                   ~2s of generation
#
# But SWITCHING tiers costs a cold load, because a 6GB GPU shared with the
# desktop session holds one model of consequence at a time. Measured: a
# research question right after a factual one took 42.3s (32s of it loading
# qwen2.5:3b), and a factual question right after a verification took 34.1s
# because deepseek-r1:1.5b had evicted qwen2.5:1.5b.
#
# The three default models total ~4.1GB, so they CAN coexist if Ollama is
# allowed to keep them. Set this where the Ollama server runs (for WSL, in the
# service environment, not this file):
#
#     OLLAMA_MAX_LOADED_MODELS=3
#
# With that set, tier switches stop paying a reload and every request lands in
# the 2-8s range. Without it, expect one slow request after each tier change
# and fast ones after that.
#
# Concurrent Ollama calls this process will issue. Leave at 1: >1 across
# different models thrashes rather than parallelizing on one shared GPU.
# MAX_CONCURRENT_OLLAMA_REQUESTS=1

# How long a conversation's follow-up context is kept (seconds).
# SESSION_TTL_SECONDS=7200
